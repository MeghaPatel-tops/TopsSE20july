DELIMITER //
CREATE PROCEDURE productPriceUpdate()
BEGIN
DECLARE cpid int;
DECLARE cprice float;
DECLARE done int  DEFAULT 0;


DECLARE productCur CURSOR FOR 
SELECT pid,price from product;

DECLARE CONTINUE HANDLER FOR NOT FOUND
 SET done = 1;
 
 OPEN productCur;
 
 ploop:LOOP
     FETCH productCur into cpid,cprice;
     
     IF done = 1 THEN
     LEAVE ploop;
     END IF;
     
     update product set price = cprice+200  where pid=cpid;
     
 END LOOP;
 
 CLOSE productCur;
 
 END //;
